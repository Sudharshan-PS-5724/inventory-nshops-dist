{
  "name": "multi-shop-inventory-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "api:build": "npm run build --workspace=@inventory/api",
    "api:check": "npm run check --workspace=@inventory/api",
    "api:test": "npm run test --workspace=@inventory/api",
    "api:start:dev": "npm run start:dev --workspace=@inventory/api",
    "mobile:start": "npm run start --workspace=@inventory/mobile",
    "mobile:typecheck": "npm run typecheck --workspace=@inventory/mobile"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  }
}
