{
  "name": "@inventory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "start": "node dist/main.js",
    "start:dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:runtime": "npm run build && node --test scripts/runtime.test.mjs",
    "test:watch": "vitest",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.ts\" \"*.json\"",
    "format": "prettier --write \"src/**/*.ts\" \"*.ts\" \"*.json\""
  },
  "dependencies": {
    "@fastify/helmet": "13.1.2",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "drizzle-kit": "0.31.11",
    "@types/node": "26.6.5",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
