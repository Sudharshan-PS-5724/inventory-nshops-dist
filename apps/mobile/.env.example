# Deployed NestJS API base URL; use the computer's LAN IP for a physical development device.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000/api/v1

# Leave both unset to use the local demo session. Configure both together for Supabase sign-in.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
